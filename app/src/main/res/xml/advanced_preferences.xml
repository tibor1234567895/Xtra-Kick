<androidx.preference.PreferenceScreen xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto">

    <PreferenceCategory
        android:title="@string/navigation"
        app:iconSpaceReserved="false" />

    <Preference
        android:key="nav_navigation_settings"
        android:summary="@string/nav_navigation_settings_summary"
        android:title="@string/navigation"
        app:iconSpaceReserved="false"
        app:singleLineTitle="false" />

    <PreferenceCategory
        android:title="@string/updates"
        app:iconSpaceReserved="false" />

    <Preference
        android:key="action_check_updates"
        android:title="@string/check_updates"
        app:iconSpaceReserved="false"
        app:singleLineTitle="false" />

    <Preference
        android:key="nav_update_settings"
        android:summary="@string/nav_update_settings_summary"
        android:title="@string/update_settings"
        app:iconSpaceReserved="false"
        app:singleLineTitle="false" />

    <PreferenceCategory
        android:title="@string/backup_and_restore"
        app:iconSpaceReserved="false" />

    <Preference
        android:key="action_backup_settings"
        android:title="@string/backup_settings"
        app:iconSpaceReserved="false"
        app:singleLineTitle="false" />

    <Preference
        android:key="action_restore_settings"
        android:title="@string/restore_settings"
        app:iconSpaceReserved="false"
        app:singleLineTitle="false" />

    <PreferenceCategory
        android:title="@string/network"
        app:iconSpaceReserved="false" />

    <SwitchPreferenceCompat
        android:defaultValue="false"
        android:key="player_stream_proxy"
        android:summary="@string/use_custom_proxy_desc"
        android:title="@string/use_custom_proxy"
        app:iconSpaceReserved="false"
        app:singleLineTitle="false" />

    <EditTextPreference
        android:defaultValue=""
        android:dependency="player_stream_proxy"
        android:key="player_proxy_url"
        android:summary="@string/stream_proxy_url_desc"
        android:title="@string/stream_proxy_url"
        app:iconSpaceReserved="false"
        app:singleLineTitle="false" />

    <Preference
        android:key="nav_proxy_settings"
        android:summary="@string/proxy_settings_summary"
        android:title="@string/proxy_settings"
        app:iconSpaceReserved="false"
        app:singleLineTitle="false" />

    <Preference
        android:key="nav_playback_settings"
        android:summary="@string/stream_parameters_summary"
        android:title="@string/stream_parameters"
        app:iconSpaceReserved="false"
        app:singleLineTitle="false" />

    <PreferenceCategory
        android:title="@string/privacy"
        app:iconSpaceReserved="false" />

    <SwitchPreferenceCompat
        android:defaultValue="true"
        android:key="usage_stats_enabled"
        android:summary="@string/usage_stats_summary"
        android:title="@string/usage_stats_title"
        app:iconSpaceReserved="false"
        app:singleLineTitle="false" />

    <SwitchPreferenceCompat
        android:defaultValue="true"
        android:key="crash_reports_enabled"
        android:dependency="usage_stats_enabled"
        android:summary="@string/crash_reports_summary"
        android:title="@string/crash_reports_title"
        app:iconSpaceReserved="false"
        app:singleLineTitle="false" />

    <PreferenceCategory
        android:key="advanced_category"
        android:title="@string/advanced"
        app:iconSpaceReserved="false" />

    <Preference
        android:key="nav_developer_settings"
        android:summary="@string/developer_tokens_summary"
        android:title="@string/developer_tokens"
        app:iconSpaceReserved="false"
        app:singleLineTitle="false" />

    <Preference
        android:key="nav_debug_settings"
        android:title="@string/debug_settings"
        app:iconSpaceReserved="false"
        app:singleLineTitle="false" />

</androidx.preference.PreferenceScreen>
