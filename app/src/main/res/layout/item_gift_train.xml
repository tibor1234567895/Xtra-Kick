<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="wrap_content"
    android:layout_height="wrap_content"
    android:layout_marginEnd="6dp"
    android:background="@drawable/bg_gift_train_card"
    android:gravity="center_vertical"
    android:orientation="horizontal"
    android:paddingStart="8dp"
    android:paddingTop="6dp"
    android:paddingEnd="10dp"
    android:paddingBottom="6dp">

    <View
        android:layout_width="3dp"
        android:layout_height="match_parent"
        android:background="@color/giftTrainAccent" />

    <ImageView
        android:layout_width="16dp"
        android:layout_height="16dp"
        android:layout_marginStart="6dp"
        android:contentDescription="@null"
        android:src="@drawable/baseline_card_giftcard_black_24"
        app:tint="@color/giftTrainAccent" />

    <TextView
        android:id="@+id/giftTrainCardText"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginStart="6dp"
        android:ellipsize="end"
        android:maxLines="1"
        android:maxWidth="220dp"
        android:textColor="#FFFFFFFF"
        android:textAppearance="?attr/textAppearanceBodySmall"
        tools:text="rembbu gifted a sub to kkosu" />
</LinearLayout>
