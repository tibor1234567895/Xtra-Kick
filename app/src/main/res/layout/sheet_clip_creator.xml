<?xml version="1.0" encoding="utf-8"?>
<androidx.core.widget.NestedScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:fillViewport="true">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="16dp">

        <!-- Header: Title + Close button -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <TextView
                android:id="@+id/clipHeaderTitle"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="@string/create_clip"
                android:textAppearance="?attr/textAppearanceTitleMedium"
                android:textStyle="bold" />

            <ImageButton
                android:id="@+id/clipCloseButton"
                android:layout_width="36dp"
                android:layout_height="36dp"
                android:background="?attr/selectableItemBackgroundBorderless"
                android:contentDescription="@string/close"
                android:padding="6dp"
                android:src="@drawable/baseline_close_24"
                app:tint="?android:attr/textColorSecondary" />
        </LinearLayout>

        <!-- Loading State Container -->
        <LinearLayout
            android:id="@+id/clipLoadingContainer"
            android:layout_width="match_parent"
            android:layout_height="240dp"
            android:gravity="center"
            android:orientation="vertical"
            android:visibility="gone"
            tools:visibility="gone">

            <ProgressBar
                android:layout_width="48dp"
                android:layout_height="48dp"
                android:indeterminate="true" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="16dp"
                android:text="@string/clip_preparing"
                android:textAppearance="?attr/textAppearanceBodyMedium"
                android:textColor="?android:attr/textColorSecondary" />
        </LinearLayout>

        <!-- Video Preview Card (Shared between Editor and Success view) -->
        <com.google.android.material.card.MaterialCardView
            android:id="@+id/clipPreviewCard"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="10dp"
            android:visibility="gone"
            tools:visibility="visible"
            app:cardCornerRadius="12dp"
            app:cardElevation="0dp"
            app:strokeColor="?attr/colorOutline"
            app:strokeWidth="1dp">

            <FrameLayout
                android:layout_width="match_parent"
                android:layout_height="190dp"
                android:background="@android:color/black">

                <androidx.media3.ui.PlayerView
                    android:id="@+id/clipPreview"
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    app:resize_mode="fit"
                    app:surface_type="texture_view"
                    app:use_controller="false" />

                <!-- Buffering indicator -->
                <ProgressBar
                    android:id="@+id/clipBufferingIndicator"
                    android:layout_width="40dp"
                    android:layout_height="40dp"
                    android:layout_gravity="center"
                    android:indeterminate="true"
                    android:visibility="gone" />

                <!-- Center Play/Pause Overlay -->
                <ImageButton
                    android:id="@+id/clipCenterPlayPause"
                    android:layout_width="56dp"
                    android:layout_height="56dp"
                    android:layout_gravity="center"
                    android:background="@drawable/bg_clip_preview_play"
                    android:contentDescription="@null"
                    android:padding="12dp"
                    android:src="@drawable/baseline_play_arrow_black_48"
                    app:tint="@android:color/white" />

                <!-- Mute / Unmute Button Overlay -->
                <ImageButton
                    android:id="@+id/clipMuteButton"
                    android:layout_width="36dp"
                    android:layout_height="36dp"
                    android:layout_gravity="top|end"
                    android:layout_margin="10dp"
                    android:background="@drawable/bg_clip_preview_play"
                    android:contentDescription="@string/mute"
                    android:padding="7dp"
                    android:src="@drawable/ic_volume_high"
                    app:tint="@android:color/white" />

            </FrameLayout>
        </com.google.android.material.card.MaterialCardView>

        <!-- Main Content Container (Timeline Editor) -->
        <LinearLayout
            android:id="@+id/clipContentContainer"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:visibility="gone"
            tools:visibility="visible">

            <!-- Playback Info & Quick Actions -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="10dp"
                android:gravity="center_vertical"
                android:orientation="horizontal">

                <ImageButton
                    android:id="@+id/clipPlayPauseButton"
                    android:layout_width="36dp"
                    android:layout_height="36dp"
                    android:background="?attr/selectableItemBackgroundBorderless"
                    android:contentDescription="@null"
                    android:padding="6dp"
                    android:src="@drawable/baseline_play_arrow_black_48"
                    app:tint="?attr/colorPrimary" />

                <TextView
                    android:id="@+id/clipCurrentTime"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="4dp"
                    android:fontFamily="monospace"
                    android:textAppearance="?attr/textAppearanceBodyMedium"
                    android:textStyle="bold"
                    tools:text="01:18" />

                <TextView
                    android:id="@+id/clipTotalTime"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="4dp"
                    android:fontFamily="monospace"
                    android:textAppearance="?attr/textAppearanceBodySmall"
                    android:textColor="?android:attr/textColorSecondary"
                    tools:text="/ 03:00" />

                <View
                    android:layout_width="0dp"
                    android:layout_height="1dp"
                    android:layout_weight="1" />

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/clipSetStartButton"
                    style="?attr/materialButtonOutlinedStyle"
                    android:layout_width="wrap_content"
                    android:layout_height="36dp"
                    android:layout_marginEnd="6dp"
                    android:insetTop="0dp"
                    android:insetBottom="0dp"
                    android:paddingHorizontal="10dp"
                    android:text="@string/clip_set_start"
                    android:textSize="12sp" />

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/clipSetEndButton"
                    style="?attr/materialButtonOutlinedStyle"
                    android:layout_width="wrap_content"
                    android:layout_height="36dp"
                    android:insetTop="0dp"
                    android:insetBottom="0dp"
                    android:paddingHorizontal="10dp"
                    android:text="@string/clip_set_end"
                    android:textSize="12sp" />
            </LinearLayout>

            <!-- Unified Clip Timeline (Start/End Handles + Playhead Scrubber) -->
            <com.xtrakick.app.ui.player.ClipTimelineView
                android:id="@+id/clipTimeline"
                android:layout_width="match_parent"
                android:layout_height="52dp"
                android:layout_marginTop="8dp" />

            <!-- Clip Range Summary Label -->
            <TextView
                android:id="@+id/clipRangeLabel"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="6dp"
                android:gravity="center"
                android:textAppearance="?attr/textAppearanceBodySmall"
                android:textColor="?android:attr/textColorSecondary"
                tools:text="01:00 – 03:00 · 120s" />

            <!-- Title input with Material 3 TextInputLayout -->
            <com.google.android.material.textfield.TextInputLayout
                android:id="@+id/clipTitleLayout"
                style="?attr/outlinedTextInputLayoutStyle"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="10dp"
                android:hint="@string/clip_title_hint"
                app:boxCornerRadiusBottomEnd="8dp"
                app:boxCornerRadiusBottomStart="8dp"
                app:boxCornerRadiusTopEnd="8dp"
                app:boxCornerRadiusTopStart="8dp"
                app:counterEnabled="true"
                app:counterMaxLength="50"
                app:endIconMode="clear_text">

                <com.google.android.material.textfield.TextInputEditText
                    android:id="@+id/clipTitleInput"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:importantForAutofill="no"
                    android:inputType="textCapSentences"
                    android:maxLength="50"
                    android:maxLines="1"
                    android:textAppearance="?attr/textAppearanceBodyMedium" />

            </com.google.android.material.textfield.TextInputLayout>

            <!-- Footer Actions -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="12dp"
                android:gravity="center_vertical"
                android:orientation="horizontal">

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/clipCancelButton"
                    style="?attr/borderlessButtonStyle"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/cancel" />

                <View
                    android:layout_width="0dp"
                    android:layout_height="1dp"
                    android:layout_weight="1" />

                <ProgressBar
                    android:id="@+id/clipSaveProgress"
                    android:layout_width="24dp"
                    android:layout_height="24dp"
                    android:layout_marginEnd="12dp"
                    android:visibility="gone"
                    tools:visibility="visible" />

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/clipSaveButton"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/save"
                    android:textStyle="bold"
                    app:cornerRadius="8dp" />

            </LinearLayout>

        </LinearLayout>

        <!-- Success & Share Container -->
        <LinearLayout
            android:id="@+id/clipSuccessContainer"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:orientation="vertical"
            android:visibility="gone"
            tools:visibility="visible">

            <!-- Clip Title & Subtitle -->
            <TextView
                android:id="@+id/clipSuccessTitle"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:textAppearance="?attr/textAppearanceTitleMedium"
                android:textSize="18sp"
                android:textStyle="bold"
                tools:text="Insane 360 No Scope" />

            <TextView
                android:id="@+id/clipSuccessSubtitle"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="2dp"
                android:textAppearance="?attr/textAppearanceBodySmall"
                android:textColor="?android:attr/textColorSecondary"
                tools:text="Clipped from sxb · 30s" />

            <!-- Created Clip Scrubber & Playback Controls Row -->
            <LinearLayout
                android:id="@+id/clipSuccessControlsRow"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="10dp"
                android:gravity="center_vertical"
                android:orientation="horizontal">

                <ImageButton
                    android:id="@+id/clipSuccessPlayPause"
                    android:layout_width="36dp"
                    android:layout_height="36dp"
                    android:background="?attr/selectableItemBackgroundBorderless"
                    android:contentDescription="@null"
                    android:padding="6dp"
                    android:src="@drawable/baseline_pause_black_48"
                    app:tint="#53FC18" />

                <TextView
                    android:id="@+id/clipSuccessCurrentTime"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="2dp"
                    android:fontFamily="monospace"
                    android:textAppearance="?attr/textAppearanceBodyMedium"
                    android:textStyle="bold"
                    tools:text="00:14" />

                <androidx.appcompat.widget.AppCompatSeekBar
                    android:id="@+id/clipSuccessSeekBar"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:max="1000"
                    android:paddingHorizontal="6dp"
                    android:progressTint="#53FC18"
                    android:thumbTint="#53FC18" />

                <TextView
                    android:id="@+id/clipSuccessTotalTime"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginEnd="2dp"
                    android:fontFamily="monospace"
                    android:textAppearance="?attr/textAppearanceBodySmall"
                    android:textColor="?android:attr/textColorSecondary"
                    tools:text="00:30" />

            </LinearLayout>

            <!-- Primary Action: Share Clip -->
            <com.google.android.material.button.MaterialButton
                android:id="@+id/clipShareButton"
                style="?attr/primaryButtonStyle"
                android:layout_width="match_parent"
                android:layout_height="48dp"
                android:layout_marginTop="16dp"
                android:text="@string/share_clip"
                android:textAllCaps="false"
                android:textStyle="bold"
                app:cornerRadius="10dp"
                app:icon="@drawable/ic_share_24"
                app:iconGravity="textStart" />

            <!-- Secondary Actions: Copy Link & Watch Clip -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:layout_marginBottom="12dp"
                android:orientation="horizontal">

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/clipCopyButton"
                    style="?attr/materialButtonOutlinedStyle"
                    android:layout_width="0dp"
                    android:layout_height="44dp"
                    android:layout_weight="1"
                    android:text="@string/copy_link"
                    android:textAllCaps="false"
                    app:cornerRadius="10dp"
                    app:icon="@drawable/baseline_content_copy_24"
                    app:iconGravity="textStart" />

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/clipWatchButton"
                    style="?attr/materialButtonOutlinedStyle"
                    android:layout_width="0dp"
                    android:layout_height="44dp"
                    android:layout_marginStart="8dp"
                    android:layout_weight="1"
                    android:text="@string/watch_clip"
                    android:textAllCaps="false"
                    app:cornerRadius="10dp"
                    app:icon="@drawable/ic_play_arrow"
                    app:iconGravity="textStart" />

            </LinearLayout>

        </LinearLayout>

    </LinearLayout>

</androidx.core.widget.NestedScrollView>
