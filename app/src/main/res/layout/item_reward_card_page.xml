<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:clipChildren="false">

    <com.google.android.material.card.MaterialCardView
        android:id="@+id/rewardCard"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:layout_marginHorizontal="6dp"
        android:clipChildren="false"
        app:cardBackgroundColor="@color/surfaceContainerAmoled"
        app:cardCornerRadius="16dp"
        app:strokeColor="?attr/colorOutline"
        app:strokeWidth="1dp">

        <FrameLayout
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:clipChildren="false">

            <!-- Roulette Reel Stage: unbox one-shot + looping glitch-particle background video + strip.
                 Z-order matches kick.com: reel pops in above the fading crate at spin start,
                 and rewardImage (last child) mounts above the reel during the handoff. -->
            <FrameLayout
                android:id="@+id/rouletteContainer"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:clipChildren="false"
                android:background="#000000"
                android:visibility="gone">

                <!-- Looping glitch-particle background video (bottom layer) -->
                <androidx.media3.ui.PlayerView
                    android:id="@+id/reelBackgroundVideo"
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:contentDescription="@null"
                    android:visibility="gone"
                    app:resize_mode="zoom"
                    app:surface_type="texture_view"
                    app:use_controller="false" />

                <!-- Unbox lid-pop one-shot video (middle layer, on top of background video) -->
                <androidx.media3.ui.PlayerView
                    android:id="@+id/stageUnboxVideo"
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:contentDescription="@null"
                    app:resize_mode="zoom"
                    app:surface_type="texture_view"
                    app:use_controller="false" />

                <!-- The horizontal scrolling strip of reward tiles -->
                <LinearLayout
                    android:id="@+id/rouletteStrip"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_gravity="center_vertical"
                    android:clipChildren="false"
                    android:orientation="horizontal"
                    android:visibility="gone" />
            </FrameLayout>

            <ImageView
                android:id="@+id/rewardImage"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:contentDescription="@string/daily_reward_winner"
                android:padding="16dp"
                android:scaleType="fitCenter"
                tools:src="@tools:sample/avatars" />
        </FrameLayout>
    </com.google.android.material.card.MaterialCardView>
</FrameLayout>
