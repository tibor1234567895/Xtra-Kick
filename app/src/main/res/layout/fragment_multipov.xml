<?xml version="1.0" encoding="utf-8"?><FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"    xmlns:app="http://schemas.android.com/apk/res-auto"    xmlns:tools="http://schemas.android.com/tools"    android:id="@+id/multiPovShell"    android:layout_width="match_parent"    android:layout_height="match_parent"    android:background="@android:color/transparent"    android:clipChildren="true">    <!-- FrameLayout so landscape can slide chat (fixed width + translationX) like the solo player. -->    <FrameLayout        android:id="@+id/multiPovRoot"        android:layout_width="match_parent"        android:layout_height="match_parent"        android:background="?android:colorBackground"        android:clipChildren="true">        <FrameLayout            android:id="@+id/videoSection"            android:layout_width="match_parent"            android:layout_height="match_parent"            android:background="@android:color/black"            android:clipChildren="true">            <LinearLayout                android:id="@+id/tileGrid"                android:layout_width="match_parent"                android:layout_height="match_parent"                android:clipChildren="true"                android:orientation="vertical" />            <!--              Chrome overlay:              - One top session bar (close | chips | tools)              - Solo-style focused player controls underneath            -->            <LinearLayout                android:id="@+id/controlsOverlay"                android:layout_width="match_parent"                android:layout_height="match_parent"                android:background="#66000000"                android:clickable="true"                android:focusable="true"                android:orientation="vertical"                android:visibility="gone"                tools:visibility="visible">                <!-- Single top bar: left actions | focus chips (flex) | right tools -->                <LinearLayout              