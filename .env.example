# Copy this file to .env and set values for local builds.
KICK_CLIENT_ID=
KICK_OAUTH_BACKEND_BASE_URL=https://kickauth.example.invalid

# Optional: preserve a custom debug signing identity for adb updates.
# LOCAL_DEBUG_KEYSTORE_FILE=/absolute/path/to/debug-keystore.jks
# LOCAL_DEBUG_STORE_PASSWORD=
# LOCAL_DEBUG_KEY_ALIAS=
# LOCAL_DEBUG_KEY_PASSWORD=

# Release signing. Required for `assembleRelease` — the build fails with an explicit
# message if these are missing, rather than silently signing with the debug key.
# Pass -PALLOW_UNSIGNED_RELEASE=true to build an unsigned release without them.
# RELEASE_KEYSTORE_FILE=/absolute/path/to/release.jks
# RELEASE_STORE_PASSWORD=
# RELEASE_KEY_ALIAS=
# RELEASE_KEY_PASSWORD=
